# Mapbox Token (required for map tiles)
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# API URL
# Kosongkan untuk same-origin (path relatif /api, /health) — rekomendasi untuk
# deployment single-domain di belakang reverse proxy (OpenResty/1Panel).
# Isi hanya jika backend berada di origin berbeda, mis. https://api.merute.my.id
VITE_API_URL=

# Target proxy backend saat dev/preview lokal (default http://localhost:8001)
VITE_DEV_API_PROXY=http://localhost:8001
