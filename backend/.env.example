# Backend Environment Variables

# GraphHopper URL
# Lokal: http://localhost:8989
# Produksi (docker compose): http://graphhopper:8989
GRAPHHOPPER_URL=http://localhost:8989

# Mapbox Token (for elevation fallback)
MAPBOX_TOKEN=

# Open-Elevation API URL
OPEN_ELEVATION_URL=https://api.open-elevation.com/api/v1/lookup

# CORS Origins (comma-separated)
# Lokal: http://localhost:5173,http://localhost:3000
# Produksi single-domain: https://merute.my.id (CORS nyaris tak terpakai, tetap set domain)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === Runtime server (dipakai run.py) ===
# Lokal default: RELOAD=true, WORKERS=1. Produksi: RELOAD=false, WORKERS=2.
# HOST=0.0.0.0
# PORT=8001
# RELOAD=true
# WORKERS=1
# LOG_LEVEL=info

# === AI Feature Configuration ===
AI_FEATURE_ENABLED=false
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_ROUTE_POINTS=120
