      "multiply_by": 1.0
    },
    {
      "if": "road_class == FOOTWAY",
      "multiply_by": 1.0
    },
    {
      "if": "road_class == PATH",
      "multiply_by": 0.95
    },
    {
      "if": "road_class == STEPS",
      "multiply_by": 0.45
    },
    {
      "if": "road_class == TRACK",
